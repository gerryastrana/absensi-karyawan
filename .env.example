# ==============================================================================
# KONFIGURASI DATABASE CLOUD SUPABASE (POSTGRESQL)
# 
# PANDUAN PENGGUNAAN:
# 1. Duplikat / buat salinan file ini dengan nama: .env.local
# 2. Buka dashboard proyek Supabase Anda di https://supabase.com
# 3. Masuk ke Project Settings (ikon Gerigi) -> API
# 4. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL
# 5. Salin "Project API Key (anon/public)" ke NEXT_PUBLIC_SUPABASE_ANON_KEY
# 6. Restart server development: Matikan terminal (Ctrl+C), lalu jalankan `npm run dev`
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

